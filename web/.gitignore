node_modules
dist
dist-ssr
.vite
*.local
.env
.env.local
.DS_Store

# TS incremental build info
*.tsbuildinfo

# Wrangler local state: local D1 sqlite, asset manifests, dev cache.
.wrangler/

# SvelteKit generates these on every `svelte-kit sync` / build. .svelte-kit
# holds the generated tsconfig, route manifest and type declarations that
# tsconfig.json extends - regenerated, never edited, never committed.
.svelte-kit

# The admin SPA build (admin/vite.config.ts): its output directory, and the
# module it generates for the Worker. Both are rebuilt by `npm run build:admin`;
# a committed copy could deploy an admin older than its source.
.admin-build/
worker/generated/
