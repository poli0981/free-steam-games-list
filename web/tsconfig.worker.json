{
  // Separate from tsconfig.json on purpose: the Worker runs on workerd, not in
  // a browser, so it must not see the DOM lib — otherwise browser-only globals
  // typecheck fine here and then fail at runtime.
  //
  // worker-configuration.d.ts is generated by `npx wrangler types` from
  // wrangler.jsonc and supplies Env, ExecutionContext and the runtime globals.
  // Re-run that command after changing bindings or vars.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["worker", "worker-configuration.d.ts"],
  // Tests run on Node under Vitest, not on workerd. Including them here
  // would either fail (no Node types) or, worse, pass by adding Node types
  // to the Worker's surface - which is exactly the confusion the split
  // above exists to prevent. They are typechecked by tsconfig.test.json.
  "exclude": ["worker/**/*.test.ts"]
}
