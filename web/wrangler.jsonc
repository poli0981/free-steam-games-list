// The ONLY deployment config for this project.
//
// Cloudflare Workers Builds (dashboard -> Worker -> Settings -> Build) is
// pointed at this repo with root directory "web", so this file, package.json
// and the lockfile sit together and dependency auto-detection works. There is
// deliberately no deploy workflow in .github/workflows — pushing main deploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // MUST match the existing Worker that holds the free-steam-games.win
  // custom domain. Deploying under any other name creates a second,
  // domainless Worker and leaves the live site on the old build.
  "name": "free-steam-games-list",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-10",

  // Empty on purpose. The Worker uses only fetch, Web Crypto and D1, so
  // nodejs_compat would add cold-start cost for nothing.
  "compatibility_flags": [],

  // No *.workers.dev hostname. A zone-scoped Cloudflare Access policy does not
  // cover workers.dev, so leaving it enabled would expose /admin — and the
  // repo-write credential behind it — on an unprotected hostname.
  "workers_dev": false,

  "assets": {
    // Vite's build output. NOT "." — pointing this at the source directory
    // once served an unbuilt index.html (referencing /src/main.tsx) along with
    // the whole source tree. The admin app is NOT in here: it is embedded in
    // the Worker script (admin/, worker/generated/admin-bundle.ts).
    "directory": "./dist",

    // Lets worker/index.ts fall through via env.ASSETS.fetch(request).
    "binding": "ASSETS",

    // Any path matching no file returns index.html with HTTP 200 - the
    // PRERENDERED dashboard, which src/lib/fallback-route.ts corrects for the
    // routes that can arrive this way. Replaces the GitHub Pages 404.html trick.
    //
    // Consequence worth remembering: a request for a DELETED hashed chunk also
    // gets index.html at 200, so the browser rejects it on MIME type rather
    // than status. src/lib/chunk-error.ts's isChunkLoadError matches that
    // message.
    "not_found_handling": "single-page-application",

    // Worker code runs ONLY for these prefixes; everything else is served
    // straight from the asset server, unbilled, never invoking the Worker.
    // /img/* must be listed or image requests fall through to the SPA handler
    // and come back as index.html with Content-Type: text/html. /admin must be
    // listed or the SPA fallback serves the public shell where Access is
    // expected, and it covers the admin app's own /admin/assets/*. /_app/* is
    // deliberately NOT listed — routing the site's hashed bundles through the
    // Worker would bill every JS/CSS request.
    "run_worker_first": ["/api/*", "/img/*", "/admin", "/admin/*"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Admin-only state: the new-games queue, decisions, commit jobs and the
  // audit log. (Not "edit drafts" - there is no such table.) Game data
  // stays canonical in Git — D1 never holds game records.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "f2p-admin",
      "database_id": "31b570e2-1863-4ccd-a019-dee4eadc3921",
      // Without this wrangler looks in web/migrations and reports "no
      // migrations present" while the files sit here.
      "migrations_dir": "./worker/migrations"
    }
  ],

  // Reconcile approvals against the published dataset. Every 15 minutes rather
  // than hourly because the gap between approving and seeing it land is the
  // one moment a reviewer is actually watching; a tick with nothing approved
  // costs one indexed D1 query and returns before any fetch.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    "SITE_ORIGIN": "https://free-steam-games.win",

    // Image transformations bill separately from Workers Paid (5,000 unique per
    // month free, then a distinct Images subscription) and Cloudflare has no
    // spend cap. Ship OFF, read real /img/* volume from Workers Logs, then
    // decide. Passthrough still gets edge caching.
    "IMG_TRANSFORM": "false",

    // Days audit_log and commit_jobs rows are kept (worker/lib/prune.ts, run
    // once a day from the cron). docs/PRIVACY_POLICY.md states this number -
    // change both together. Values under 7 are ignored as a safety floor.
    "ADMIN_RETENTION_DAYS": "180",

    // Countries refused by the Worker, ISO 3166-1 alpha-2, comma separated.
    // "CN" is mainland China only - Hong Kong, Macau and Taiwan are HK, MO and
    // TW and stay reachable.
    //
    // This is DEFENCE IN DEPTH, not the boundary. The Worker only ever sees
    // the four `assets.run_worker_first` prefixes, so the prerendered HTML is
    // not covered by it; a WAF custom rule on the zone is what actually blocks
    // a country. See docs/SECURITY_SETUP.md. Empty or unset blocks nothing.
    "BLOCKED_COUNTRIES": "CN,RU,AR",

    // Cloudflare Access. Neither value is a secret: the team domain appears in
    // the login redirect and the AUD tag identifies the application. They are
    // vars so the Worker can verify tokens itself rather than trusting that a
    // request reached it through the Access-protected path.
    "ACCESS_TEAM_DOMAIN": "polished-hall-48fd.cloudflareaccess.com",
    // AUDs are grouped BY ROUTE, not pooled into one list. verifyAccessJwt is
    // called with only the group a route accepts, so the unattended discovery
    // token cannot reach /admin/api/* (which holds a repository-write
    // credential) and an admin session cannot reach /api/ingest/*.
    //
    // These are not secrets: any Access-covered path 302s to a login URL
    // carrying its own AUD as the `kid=` query parameter, readable with an
    // unauthenticated curl. Add a tag here whenever another Access application
    // is pointed at this Worker, or every request through it is refused with
    // `access: aud mismatch` in `wrangler tail`.
    //
    //   ca93cf2c...  /admin, which covers the SPA AND its API at /admin/api/*
    //                (email policy). ONE application on purpose: a separate one
    //                for the API (a15d6e93..., /api/admin/*, retired) left the
    //                page's fetches without a session - see ADMIN_API_PREFIX in
    //                shared/admin-routes.ts.
    "ACCESS_AUD_ADMIN": "ca93cf2c7444c20f13b0667a3063d4ac37f702a802e712721da53abb510f9194",

    //   bd54655a...  /api/ingest/* (Service Auth, token f2p-discovery)
    "ACCESS_AUD_INGEST": "bd54655abb62f1bb72f8541177ef2406a066007a4c5ac60eb654f90f6ea88754"
  }
}
