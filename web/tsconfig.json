{
  // Generated by SvelteKit from svelte.config.js. It supplies the $lib and
  // $app aliases, the right module/target settings, and the include list -
  // none of which should be restated here, because SvelteKit changes them
  // between versions and a hand-written copy drifts silently.
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    // Restored deliberately. Two node_modules-internal clashes need it and
    // neither is ours to fix:
    //   - src/workers/jsonl-parser.ts carries `/// <reference lib="webworker" />`,
    //     which puts lib.webworker.d.ts and lib.dom.d.ts in one program; they
    //     declare `self`, `onmessage` and friends with different types.
    //   - TypeScript resolves `cookie` to the HOISTED 1.1.1 (pulled in by
    //     wrangler -> miniflare -> youch) while @sveltejs/kit has its own
    //     nested cookie@0.6.0 and uses that at runtime. The type error is a
    //     resolution artifact, not a real version conflict.
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    // No "paths" here. SvelteKit generates its own and warns that a
    // hand-written one breaks intellisense; the "@" alias is declared in
    // svelte.config.js under kit.alias instead, which feeds both the
    // generated tsconfig and the bundler.
    "types": ["node"]
  }
}
