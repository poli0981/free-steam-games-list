{
  // SvelteKit generates the base config into node_modules/$app on every
  // `svelte-kit sync` (which `npm run check` and `build:admin` run first). It
  // supplies the $app types and the module/target settings, none of which
  // should be restated here, because SvelteKit changes them between versions
  // and a hand-written copy drifts silently.
  //
  // Since SvelteKit 3 the base no longer says WHICH files belong to the app,
  // so `include` is ours. It is what SvelteKit 2 generated, minus the Worker:
  // src and the Vite config (which pulls in build/), plus build/'s tests.
  // worker/ has its own tsconfig.worker.json and must not be checked against
  // the DOM lib here.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // The base sets it as well; it stays here because two declaration-file
    // clashes need it and neither is ours to fix (measured with it off,
    // 2026-10-26):
    //   - src/workers/jsonl-parser.ts carries `/// <reference lib="webworker" />`,
    //     which puts lib.webworker.d.ts and lib.dom.d.ts in one program; they
    //     declare `self`, `onmessage` and friends with different types.
    //   - echarts-wordcloud's index.d.ts default-imports echarts, whose 6.x
    //     types have no default export (the package.json override that keeps
    //     it on echarts 6 is about its runtime, which works).
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Replaces the base's list, so its $app/types has to be repeated.
    "types": ["$app/types", "node"],
    // The `imports` entry of package.json, repeated for `svelte-check --tsgo`.
    // TypeScript resolves `#lib/...` through package.json on its own, but
    // svelte-check redirects .svelte imports to the declarations it emits only
    // through `paths`: without this, every component imported as
    // `#lib/....svelte` fell back to the ambient `*.svelte` shim - its props
    // unchecked, its module exports missing.
    "paths": { "#lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "build/**/*.test.ts"]
}
