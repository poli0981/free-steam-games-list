# ========================
# 1. GENERAL & SYSTEM (OS Files, Logs, Temp Files)
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
# scripts/dead_games.log is a COMMITTED audit trail: appended by
# scripts/mark_dead_games.py and explicitly staged by mark-dead-games.yml.
# It survives *.log today only because ignore rules do not apply to
# already-tracked files -- rename or recreate it and it silently vanishes.
# (scripts/dead_links.log is deliberately NOT excepted: bash/dead_links.sh
# runs `git add .`, and that log is local diagnostic output.)
!scripts/dead_games.log
*.tmp
*.temp
*.swp

# ========================
# 2. IDE & EDITORS (JetBrains, VS Code, VS, Xcode...)
# ========================
# JetBrains (IntelliJ, PyCharm, CLion...)
.idea/
*.iws
*.iml
*.ipr

# VS Code. `.vscode/*` not `.vscode/`: git does not descend into an excluded
# DIRECTORY, so a negation cannot re-include a file whose parent is excluded --
# the four exceptions below were dead code.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio (Windows/Mac)
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Xcode (MacOS/iOS/Swift)
*.xcworkspace
!default.xcworkspace
xcuserdata/
derivedData/

# Android Studio
local.properties

# ========================
# 3. SECURITY & ENV [IMPORTANT: DO NOT UPLOAD SENSITIVE FILES]
# ========================
.env
.env.local
.env.*.local
# .env.production / .env.development matched none of the three rules above.
.env.*
!.env.example

# Wrangler local secrets. `wrangler dev` reads GH_APP_PRIVATE_KEY -- the
# GitHub App PEM that can commit to this repo -- from here, INLINE, so the
# *.pem and *.key rules below do not cover it.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Android signing keystores. web/src-tauri/TAURI.md walks you through
# `keytool -genkeypair -keystore f2p-tracker-release.jks` with a relative path
# inside gen/android/, and only keystore.properties was ignored. Losing or
# leaking this key means the Android app can never be updated again.
*.jks
*.keystore
*.p12
*.pfx

*.pem
*.key
*.cer
secrets.json
id_rsa
id_rsa.pub

# ========================
# 4. PYTHON (Django, Flask, Scripts)
# ========================
__pycache__/
*.py[cod]
*$py.class
# Virtual Environments
venv/
.venv/
# Anchored: unanchored `env/` matched web/worker/env/ at any depth, silently
# dropping Worker source. (On Windows core.ignorecase makes ENV/ match env/.)
/env/
/ENV/
.virtualenv/

# Distribution / Packaging. Anchored to the repo root: web/dist is covered by
# web/.gitignore, and Android build dirs by the nested gitignores that
# `tauri android init` wrote, so unanchored forms only risk hiding real source.
/build/
/dist/
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Database
*.db
*.sqlite
*.sqlite3

# ========================
# 5. WEB FULL-STACK (NodeJS, React, Vue, Angular)
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Build production
.next/
.nuxt/
# Coverage
coverage/
.nyc_output/

# F2P Tracker desktop / Android app (Tauri 2 + Rust, at web/src-tauri).
# NOTE: there is no app/ directory in this repo — an earlier version of this
# block ignored app/** and described the shell as Electron. Both were wrong.
web/src-tauri/target/
web/src-tauri/gen/android/app/build/
web/src-tauri/gen/apple/build/

# ========================
# 6. MOBILE CROSS-PLATFORM
# ========================
# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# React Native
android/app/build/
ios/Pods/
.bundle/

